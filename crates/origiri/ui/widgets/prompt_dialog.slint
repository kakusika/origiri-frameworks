import { Tokens } from "@origiri/tokens.slint";
import { AppButton } from "@origiri/widgets/app_button.slint";
import { ModalDialog } from "modal_dialog.slint";

// PromptDialog: single-line text input modal dialog for rename, new item, or value prompts.
export component PromptDialog inherits ModalDialog {
    dialog-width: 320px;
    in property <string> message: "";
    in-out property <string> value: "";
    in property <string> placeholder-text: "";
    in property <string> confirm-text: "OK";
    in property <string> cancel-text: "Cancel";
    in property <bool> show-cancel: true;

    callback confirmed(string);
    callback cancelled();

    forward-focus: text-field;

    public function select-all() {
        text-field.select-all();
    }

    if root.message != "": Text {
        text: root.message;
        color: Tokens.text-secondary;
        font-size: Tokens.font-size-normal;
        wrap: word-wrap;
    }

    Rectangle {
        height: 32px;
        border-radius: Tokens.corner-radius;
        border-width: text-field.has-focus ? 1.5px : Tokens.border-width;
        border-color: text-field.has-focus ? Tokens.accent : (field-touch.has-hover ? Tokens.border-hover-on-surface : Tokens.border-on-surface);
        background: Tokens.surface;

        animate border-color {
            duration: Tokens.anim-very-short * 1ms;
            easing: ease-out;
        }
        animate border-width {
            duration: Tokens.anim-very-short * 1ms;
            easing: ease-out;
        }

        field-touch := TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => { text-field.focus(); }
        }

        HorizontalLayout {
            padding-left: Tokens.spacing-medium;
            padding-right: Tokens.spacing-medium;

            text-field := TextInput {
                text <=> root.value;
                color: Tokens.text-primary;
                font-size: Tokens.font-size-normal;
                vertical-alignment: center;
                single-line: true;
                accepted => {
                    root.confirmed(self.text);
                    root.close();
                }
            }
        }

        if text-field.text == "" && root.placeholder-text != "" && !text-field.has-focus: Text {
            x: Tokens.spacing-medium;
            text: root.placeholder-text;
            color: Tokens.text-disabled-on-surface;
            font-size: Tokens.font-size-normal;
            vertical-alignment: center;
        }
    }

    Rectangle {
        height: 1px;
        background: Tokens.divider;
    }

    HorizontalLayout {
        alignment: end;
        spacing: Tokens.spacing-small;

        if root.show-cancel: AppButton {
            text: root.cancel-text;
            clicked => {
                root.cancelled();
                root.close();
            }
        }

        AppButton {
            text: root.confirm-text;
            primary: true;
            clicked => {
                root.confirmed(root.value);
                root.close();
            }
        }
    }
}
