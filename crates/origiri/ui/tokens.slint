// Shared design-token global. Imported by consuming apps via slint-build's
// library-path mechanism (`import { Tokens } from "@origiri/tokens.slint";`),
// NOT copied per app.
//
// Every property is `in-out` (not `out`) so a consuming app's own Rust glue
// can push resolved values in at runtime (`origiri_theme::resolve`, from the
// `ThemeSettings` the app passes in). The literal defaults below are just a
// sane compile-time fallback so a UI still renders sensibly before that push
// happens -- they mirror `origiri-theme`'s `ColorTokens`/`ShapeTokens`/
// `SpacingTokens` 1:1; keep both in sync by hand if either changes.
export global Tokens {
    // -- Colors (Origiri Norimusubi & Umeboshi Palette; the dark preset resolved) --
    // Every color is opaque. The three grounds come first; what is drawn on a
    // ground (borders, hover, selection, quiet text, accent washes) is
    // declared once per ground -- no suffix for `background`, `-on-surface`
    // for `surface`, `-on-raised` for `surface-raised` -- already blended
    // against it, so a view picks the set for the ground it sits on and
    // never tints a color at the point of use.
    in-out property <color> background: #070908;
    in-out property <color> surface: #1c221e;
    in-out property <color> surface-raised: #2a322c;
    in-out property <color> accent: #d43838;
    in-out property <color> text-on-accent: #f4f5f3;
    in-out property <color> text-on-destructive: #f4f5f3;
    in-out property <color> text-primary: #f4f5f3;
    in-out property <color> destructive: #da4453;
    in-out property <color> accent-hover: #d95050;
    in-out property <color> accent-pressed: #aa2d2d;
    in-out property <color> destructive-hover: #de5a68;
    in-out property <color> destructive-pressed: #ae3642;
    in-out property <color> success: #10b981;
    in-out property <color> warning: #f59e0b;

    in-out property <color> border: #232524;
    in-out property <color> border-hover: #535553;
    in-out property <color> divider: #363837;
    in-out property <color> hover: #26100f;
    in-out property <color> pressed: #6e2120;
    in-out property <color> selected: #3a1514;
    in-out property <color> text-secondary: #a1a2a1;
    in-out property <color> text-disabled: #727372;
    in-out property <color> accent-soft: #4f1919;
    in-out property <color> accent-strong: #822525;
    in-out property <color> destructive-soft: #311517;
    in-out property <color> destructive-border: #71272e;
    in-out property <color> success-soft: #092c20;
    in-out property <color> success-border: #0c6145;

    in-out property <color> border-on-surface: #363b38;
    in-out property <color> border-hover-on-surface: #616662;
    in-out property <color> divider-on-surface: #474c49;
    in-out property <color> hover-on-surface: #382522;
    in-out property <color> pressed-on-surface: #782d2b;
    in-out property <color> selected-on-surface: #4a2825;
    in-out property <color> text-secondary-on-surface: #a8aba8;
    in-out property <color> text-disabled-on-surface: #7d817e;
    in-out property <color> accent-soft-on-surface: #5c2a27;
    in-out property <color> accent-strong-on-surface: #8a2f2e;
    in-out property <color> destructive-soft-on-surface: #422929;
    in-out property <color> destructive-border-on-surface: #7b3339;
    in-out property <color> success-soft-on-surface: #1a4032;
    in-out property <color> success-border-on-surface: #166e50;

    in-out property <color> border-on-raised: #424944;
    in-out property <color> border-hover-on-raised: #6b706c;
    in-out property <color> divider-on-raised: #525954;
    in-out property <color> hover-on-raised: #44332e;
    in-out property <color> pressed-on-raised: #7f3532;
    in-out property <color> selected-on-raised: #55342f;
    in-out property <color> text-secondary-on-raised: #adb1ad;
    in-out property <color> text-disabled-on-raised: #858a86;
    in-out property <color> accent-soft-on-raised: #663430;
    in-out property <color> accent-strong-on-raised: #903633;
    in-out property <color> destructive-soft-on-raised: #4d3634;
    in-out property <color> destructive-border-on-raised: #823b40;
    in-out property <color> success-soft-on-raised: #254d3d;
    in-out property <color> success-border-on-raised: #1d7657;

    // -- Spacing --
    in-out property <length> spacing-small: 4px;
    in-out property <length> spacing-medium: 8px;
    in-out property <length> spacing-large: 16px;

    // -- Shape --
    in-out property <length> corner-radius: 4px;
    in-out property <length> border-width: 1px;

    // -- Typography (not yet resolved from settings -- no persisted font
    // setting this crate reads today, kept as fixed literals) --
    // Sized for CJK legibility: a Latin-tuned 11/13/15px scale packs too many
    // strokes per em for kanji, which reads as crushed glyphs rather than
    // small text (see mumeum's 2026-10-09 report).
    in-out property <length> font-size-small: 13px;
    in-out property <length> font-size-normal: 15px;
    in-out property <length> font-size-large: 17px;

    // -- Animation (ms) -- 0 means "apply immediately, no animation" (see
    // `AnimationTokens` doc comment), consuming .slint files should treat
    // 0 as a valid, meaningful duration, not a placeholder.
    in-out property <int> anim-very-short: 60;
    in-out property <int> anim-short: 180;
    in-out property <int> anim-long: 360;
    in-out property <int> anim-very-long: 600;
}
